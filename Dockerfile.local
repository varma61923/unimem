# The sealed local UniMem runtime: CLI, gateway + console, and the MCP server over
# streamable HTTP, compiled to native `.so` extensions without raw `.py` sources.
#
#   docker compose --profile local up        # gateway on :8787, MCP on :8421
#   docker run --rm -v unimem:/data unimem-local query "release checklist"

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=30 \
    PIP_RETRIES=3

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY unimem/ ./unimem/
COPY protocol/ ./protocol/
COPY scripts/compile_extensions.py ./scripts/compile_extensions.py
RUN pip install --prefix=/install --no-compile ".[serve,security]" \
    && pip install --target=/compiler-tools "Cython>=3.1,<4.0" setuptools==78.1.1 wheel \
    && pkg_dir=$(python -c "import glob; print(glob.glob('/install/lib/python*/site-packages/unimem')[0])") \
    && PYTHONPATH=/compiler-tools python ./scripts/compile_extensions.py compile \
        --root "$pkg_dir" \
        --package-prefix unimem \
        --strip-sources \
        --keep-shim __init__.py \
        --keep-shim __main__.py \
        --keep-trampoline cli.py \
        --keep-trampoline warm.py \
        --keep-trampoline hook_bridge.py \
    && python ./scripts/compile_extensions.py check-no-source "$pkg_dir" \
        --allow-shim __init__.py \
        --allow-shim __main__.py

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS runtime

# Apply fixes newer than the pinned base image (PCRE2 and OpenSSL).
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade \
        libpcre2-8-0 libssl3t64 openssl openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UNIMEM_ROOT=/data

COPY --from=builder /install /usr/local
RUN useradd --create-home --uid 10001 unimem \
    && mkdir -p /data && chown unimem:unimem /data
COPY deploy/docker/local-entrypoint.sh /usr/local/bin/unimem-entrypoint
RUN chmod 0755 /usr/local/bin/unimem-entrypoint

USER unimem
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8787 8421

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8787/v1/health/live', timeout=2).status == 200 else sys.exit(1)"

ENTRYPOINT ["unimem-entrypoint"]
CMD ["gateway", "--host", "0.0.0.0", "--port", "8787"]
